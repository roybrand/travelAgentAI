# Copy this file to .env and fill in what you have. .env is never committed.

# Optional: plain-English trip requests and grounded explanations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: an OpenAI-compatible endpoint (proxy, Azure, local test server)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: real flight and hotel offers (free signup at https://developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Free test environment by default; switch to https://api.amadeus.com once you have production access
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional: live events and parties (free key at https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Optional: recent real flight fares (free affiliate signup at https://www.travelpayouts.com)
TRAVELPAYOUTS_TOKEN=

# Optional: real payment for Featured deal placements (free test-mode account at https://stripe.com).
# Both are needed together -- the secret key to start a checkout, the webhook secret to trust its result.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: real push notifications for messages and connection requests, even when the app is closed.
# Generate a free pair: python scripts/generate_vapid_keys.py -- all three are needed together.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Partner portal: a long random string that unlocks the moderation page at /admin. Leave empty to disable it.
ADMIN_TOKEN=
# Where everything the server keeps is stored, on a laptop (SQLite). Default: backend/data/partners.db
WAYFINDER_DB=
# Production: PostgreSQL, e.g. postgresql://user:password@host:5432/wayfinder (then SQLite is not used).
# Move existing data once with: python scripts/migrate_sqlite_to_postgres.py
WAYFINDER_DATABASE_URL=
# Postgres connections kept open per server process (default 10)
WAYFINDER_DB_POOL=

# Set to 1 to disable all network calls and use built-in demo data
WAYFINDER_OFFLINE=0
