# Copy this file to .env and fill in what you have. .env is never committed.

# Optional: plain-English trip requests and grounded explanations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: an OpenAI-compatible endpoint (proxy, Azure, local test server)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: real flight and hotel offers (free signup at https://developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Free test environment by default; switch to https://api.amadeus.com once you have production access
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional: live events and parties (free key at https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Optional: recent real flight fares (free affiliate signup at https://www.travelpayouts.com)
TRAVELPAYOUTS_TOKEN=

# Partner portal: a long random string that unlocks the moderation page at /admin. Leave empty to disable it.
ADMIN_TOKEN=
# Where partner accounts and deals are stored (SQLite). Default: backend/data/partners.db
WAYFINDER_DB=

# Set to 1 to disable all network calls and use built-in demo data
WAYFINDER_OFFLINE=0
